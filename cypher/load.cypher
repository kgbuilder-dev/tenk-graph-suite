// load.cypher - Alphabet 10-K seed graph (FY2024 + FY2025)
// Generated from data/seed/*.csv - every value traceable to SEC EDGAR (see README)
CREATE CONSTRAINT company_name IF NOT EXISTS FOR (c:Company) REQUIRE c.name IS UNIQUE;
CREATE CONSTRAINT filing_year IF NOT EXISTS FOR (f:Filing) REQUIRE (f.form, f.fiscalYear) IS UNIQUE;
CREATE CONSTRAINT segment_name IF NOT EXISTS FOR (s:Segment) REQUIRE s.name IS UNIQUE;

MERGE (:Company {name: 'Alphabet Inc.', jurisdiction: 'Delaware', source: '10-K FY2025 cover'});
MERGE (:Company {name: 'XXVI Holdings Inc.', jurisdiction: 'Delaware', source: 'EX-21.01 FY2025'});
MERGE (:Company {name: 'Google LLC', jurisdiction: 'Delaware', source: 'EX-21.01 FY2025'});
MERGE (:Company {name: 'Alphabet Capital US LLC', jurisdiction: 'Delaware', source: 'EX-21.01 FY2025'});
MATCH (a:Company {name: 'Alphabet Inc.'}), (b:Company {name: 'XXVI Holdings Inc.'}) MERGE (a)-[:OWNS {source: 'EX-21.01 FY2025 (direct/indirect subsidiary); 2017 restructuring'}]->(b);
MATCH (a:Company {name: 'XXVI Holdings Inc.'}), (b:Company {name: 'Google LLC'}) MERGE (a)-[:OWNS {source: '2017 Alphabet restructuring (XXVI holds Google equity), public record'}]->(b);
MATCH (a:Company {name: 'Alphabet Inc.'}), (b:Company {name: 'Alphabet Capital US LLC'}) MERGE (a)-[:OWNS {source: 'EX-21.01 FY2025 (direct/indirect subsidiary)'}]->(b);
MERGE (f:Filing {form: '10-K', fiscalYear: 2025}) SET f.filedDate = date('2026-02-05'), f.accession = '0001652044-26-000018', f.totalRevenueMusd = 402836, f.hedgingGainsMusd = -127;
MERGE (f:Filing {form: '10-K', fiscalYear: 2024}) SET f.filedDate = date('2025-02-05'), f.accession = '0001652044-25-000014', f.totalRevenueMusd = 350018, f.hedgingGainsMusd = 211;
MATCH (f:Filing), (c:Company {name: 'Alphabet Inc.'}) MERGE (f)-[:FILED_BY]->(c);
MERGE (s:Segment {name: 'Google Services'}) WITH s MATCH (f:Filing {fiscalYear: 2025}) MERGE (s)-[:REPORTED_IN {revenueMusd: 342721}]->(f);
MERGE (s:Segment {name: 'Google Cloud'}) WITH s MATCH (f:Filing {fiscalYear: 2025}) MERGE (s)-[:REPORTED_IN {revenueMusd: 58705}]->(f);
MERGE (s:Segment {name: 'Other Bets'}) WITH s MATCH (f:Filing {fiscalYear: 2025}) MERGE (s)-[:REPORTED_IN {revenueMusd: 1537}]->(f);
